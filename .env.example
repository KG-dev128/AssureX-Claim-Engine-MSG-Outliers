# AssureX Claim Engine — Environment Configuration Template
# Copy this file to .env and configure your production credentials.

FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# Database Connection (NeonDB PostgreSQL or compatible PostgreSQL instance)
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
NEONDB_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Application Secrets
SECRET_KEY=generate-a-strong-secret-key-here
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# File Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=10485760

# Rate Limiting Storage (Default is in-memory; use redis:// for multi-worker production)
RATELIMIT_STORAGE_URL=memory://

# Email Notifications (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
